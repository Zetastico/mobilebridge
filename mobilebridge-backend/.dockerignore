!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore

# Pruebas y herramientas de desarrollo local
tests
.phpunit.result.cache
phpunit.xml
.editorconfig

# Archivos de Docker y orquestación
Dockerfile
.dockerignore
render.yaml

# Documentación innecesaria en la imagen de producción
*.md
