APP_NAME=MobileBridge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-servicio.onrender.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Base de Datos (Supabase PostgreSQL / Cloud)
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

# ─────────────────────────────────────────────────────────────
# Sesiones, Cache y Colas
# ─────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ─────────────────────────────────────────────────────────────
# CORS (Orígenes Permitidos)
# Usar '*' para permitir todas las conexiones o lista separada por comas:
# ej: https://tu-frontend.com,http://localhost:3000
# ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*

# ─────────────────────────────────────────────────────────────
# Reglas de Negocio MobileBridge
# ─────────────────────────────────────────────────────────────
# Segundos antes de considerar un dispositivo Offline si no envía Heartbeat
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=60

# Ejecutar migraciones automáticamente al arrancar el contenedor (true/false)
# (Si usa Render Pre-Deploy Command, puede dejarlo en false)
AUTO_MIGRATE=false
