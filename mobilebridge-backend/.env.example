APP_NAME=MobileBridge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# Base de Datos (Local SQLite o Supabase PostgreSQL)
# ─────────────────────────────────────────────────────────────
# Para desarrollo local rápido:
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# Para Producción / Cloud con Supabase PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=tu_contraseña_supabase
# DB_SSLMODE=require

# ─────────────────────────────────────────────────────────────
# Sesiones y Cache
# ─────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ─────────────────────────────────────────────────────────────
# MobileBridge Reglas de Negocio
# ─────────────────────────────────────────────────────────────
# Segundos antes de considerar un dispositivo Offline automáticamente
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=60
